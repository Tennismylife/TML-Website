{
  "name": "tennis-starter",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "tar": "7.5.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen:thumbs && npm run gen:rss && next build",
    "start": "node scripts/start-standalone.js",
    "prisma:generate": "prisma generate",
    "test": "vitest",
    "test:ci": "set \"NODE_OPTIONS=--max-old-space-size=4096\" && vitest",
    "test:records": "vitest tests/records.unit.spec.tsx --run",
    "test:records:ci": "set \"NODE_OPTIONS=--max-old-space-size=4096\" && vitest tests/records.unit.spec.tsx --run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun --config=.lighthouserc.json",
    "fetch-fonts": "node scripts/download-fonts.js",
    "build-fonts": "node scripts/ttf-to-woff2.js",
    "gather-font-glyphs": "node scripts/gather-glyphs.js",
    "subset-fonts": "node scripts/subset-fonts.js",
    "prepare-fonts": "npm run fetch-fonts && npm run gather-font-glyphs && npm run subset-fonts && npm run build-fonts",
    "optimize-images": "node scripts/optimize-images.js",
    "generate:avif": "node scripts/generate-avif.js",
    "generate-og": "node scripts/generate-og.js",
    "generate:statistics-sitemap": "node scripts/generate-statistics-sitemap.js",
    "refresh-mvs": "node ./scripts/refresh-mvs-listener.js --once",
    "notify:indexnow": "ts-node scripts/notify-indexnow.ts",
    "start-mvs-listener": "node ./scripts/refresh-mvs-listener.js",
    "test:match-visibility": "node ./tests/test_match_visibility.js",
    "test:integration:match-visibility": "node ./tests/integration/match-visibility.spec.js",
    "start:detached": "node scripts/start-detached.js",
    "stop:detached": "node scripts/stop-detached.js",
    "check-redirects": "node scripts/check-redirects.js",
    "gen:thumbs": "node scripts/gen-thumbs.js",
    "gen:rss": "node scripts/gen-rss.js",
    "start:standalone": "node scripts/start-standalone.js"
  },
  "dependencies": {
    "@langchain/ollama": "^0.2.4",
    "@prisma/client": "^6.19.0",
    "@tensorflow/tfjs": "^4.22.0",
    "archiver": "^5.3.2",
    "compression": "^1.8.1",
    "critters": "^0.0.23",
    "csv-parse": "^5.4.8",
    "express": "^5.2.1",
    "framer-motion": "^12.23.22",
    "http-proxy-middleware": "^3.0.5",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.562.0",
    "marked": "^5.1.1",
    "next": "^16.1.4",
    "next-mdx-remote": "^4.1.0",
    "node-fetch": "^3.3.2",
    "postgres": "^3.2.0",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-icons": "^5.5.0",
    "react-is": "^19.2.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.2.1",
    "red": "^0.0.1",
    "redis": "^5.10.0",
    "rehype-raw": "^7.0.0",
    "remark-slug": "^7.0.1",
    "sanitize-html": "^2.11.0",
    "shiki": "^3.22.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/testing-library__jest-dom": "^5.14.9",
    "autoprefixer": "^10.4.22",
    "fontmin": "^1.1.1",
    "jiti": "^1.20.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.18",
    "ttf2woff2": "^8.0.0",
    "typescript": "5.4.2",
    "vitest": "^4.0.15"
  }
}
