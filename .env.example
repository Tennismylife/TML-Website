# Example environment variables for local development (sqlite) and production reference
# Copy to `.env` (local) or to your server's secure env file and update values below.

# Canonical public origin used by middleware and metadata
NEXT_PUBLIC_SITE_URL="https://stats.tennismylife.org"

# Database - example local sqlite for easier dev
DATABASE_URL=file:./dev.db

# For production use a real Postgres connection string, e.g.:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/tennis"

# Optional services
REDIS_URL="redis://127.0.0.1:6379"

# Analytics placeholders
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXX"
GA4_MEASUREMENT_ID="G-XXXXXXX"
GA4_API_SECRET=""

# Build controls
SKIP_SITEMAP_BUILD=0

# Notes:
# - Do NOT commit secrets to the repo. Keep `.env` out of version control.
# - In production prefer system-managed env files (e.g., /etc/default/tml) with secure permissions.
